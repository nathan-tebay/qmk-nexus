EM encoder_map[][NUM_ENCODERS][NUM_DIRECTIONS] = {\n    [0] = { ENCODER_CCW_CW(KC_VOLD, KC_VOLU) },\n    [1] = { ENCODER_CCW_CW(RM_HUEU, RM_HUED) },\n    [2] = { ENCODER_CCW_CW(KC_TRNS, KC_TRNS) },\n    [3] = { ENCODER_CCW_CW(KC_TRNS, KC_TRNS) },\n};\n#endif\n"}},"_default_keymap":{"layers":[["KC_MUTE","TO(1)","KC_PSLS","KC_PAST","KC_PMNS","KC_KP_7","KC_KP_8","KC_KP_9","KC_PPLS","KC_KP_4","KC_KP_5","KC_KP_6","KC_KP_1","KC_KP_2","KC_KP_3","KC_PENT","KC_KP_0","KC_PDOT"],["RM_NEXT","TO(2)","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS"],["RM_NEXT","TO(3)","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS"],["RM_NEXT","TO(0)","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS","KC_TRNS"]],"layout":"LAYOUT"}}