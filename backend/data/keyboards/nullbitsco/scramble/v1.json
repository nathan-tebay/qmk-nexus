O_STATE_HIGH 1\n\n#define PIN_LED         B2\n\nvoid set_scramble_LED(uint8_t mode);\n","keyboards/nullbitsco/scramble/v1/v1.c":"// Copyright 2022 Jay Greco\n// SPDX-License-Identifier: GPL-2.0-or-later\n\n#include \"v1.h\"\n\nvoid set_scramble_LED(uint8_t mode) {\n    switch(mode) {\n        case LED_ON:\n            gpio_set_pin_output(PIN_LED);\n            gpio_write_pin(PIN_LED, GPIO_STATE_HIGH);\n        break;\n\n        case LED_DIM:\n            gpio_set_pin_input(PIN_LED);\n        break;\n\n        case LED_OFF:\n            gpio_set_pin_output(PIN_LED);\n            gpio_write_pin(PIN_LED, GPIO_STATE_LOW);\n        break;\n\n        default:\n        break;\n    }\n}\n","keyboards/nullbitsco/scramble/v1/keyboard.json":"{\n    \"features\": {\n        \"bootmagic\": false,\n        \"encoder\": true,\n        \"extrakey\": true,\n        \"mousekey\": true,\n        \"nkro\": false\n    },\n    \"encoder\": {\n        \"rotary\": [\n            {\"pin_a\": \"D6\", \"pin_b\": \"D7\"}\n        ]\n    },\n    \"qmk\": {\n        \"tap_keycode_delay\": 10\n    },\n    \"processor\": \"atmega328p\",\n    \"bootloader\": \"usbasploader\",\n    \"matrix_pins\": {\n        \"direct\": [\n            [\"D4\", \"D5\", \"B1\"],\n            [\"C3\", \"C2\", \"C1\"]\n        ]\n    }\n}\n"}},"_default_keymap":{"layers":[["KC_F13","KC_F14","KC_F15","KC_F16","KC_F17","KC_F18"]],"layout":"LAYOUT"}}