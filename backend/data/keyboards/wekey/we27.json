ctive_splash(0, params, &SOLID_REACTIVE_WIDE_math2); }\nbool SOLID_REACTIVE_NEXUS2(effect_params_t* params) { return effect_runner_reactive_splash(qsub8(g_last_hit_tracker.count, 1), params, &SOLID_REACTIVE_NEXUS_math2); }\nbool SOLID_REACTIVE_MULTINEXUS2(effect_params_t* params) { return effect_runner_reactive_splash(0, params, &SOLID_REACTIVE_NEXUS_math2); }\n\n#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS \n","keyboards/wekey/we27/rules.mk":"RGB_MATRIX_CUSTOM_KB = yes\n","keyboards/wekey/we27/keyboard.json":"{\n    \"keyboard_name\": \"We27\",\n    \"manufacturer\": \"@wekey\",\n    \"maintainer\": \"@wekey.dev\",\n    \"usb\": {\n        \"vid\": \"0x5559\",\n        \"pid\": \"0x0001\",\n        \"device_version\": \"0.0.1\"\n    },\n    \"features\": {\n        \"bootmagic\": true,\n        \"encoder\": true,\n        \"extrakey\": true,\n        \"mousekey\": true,\n        \"nkro\": false,\n        \"rgb_matrix\": true\n    },\n    \"qmk\": {\n        \"locking\": {\n            \"enabled\": true,\n            \"resync\": true\n        }\n    },\n    \"rgb_matrix\": {\n        \"animations\": {\n            \"rainbow_moving_chevron\": true\n        },\n        \"default\": {\n            \"hue\": 108\n        },\n        \"driver\": \"ws2812\",\n        \"layout\": [\n            {\"matrix\": [0, 0], \"x\": 0, \"y\": 1, \"flags\": 1},\n            {\"matrix\": [0, 1], \"x\": 56, \"y\": 1, \"flags\": 1},\n            {\"matrix\": [0, 2], \"x\": 112, \"y\": 1, \"flags\": 1},\n            {\"matrix\": [0, 3], \"x\": 168, \"y\": 1, \"flags\": 1},\n            {\"matrix\": [0, 4], \"x\": 224, \"y\": 1, \"flags\": 1},\n            {\"matrix\": [1, 4], \"x\": 0, \"y\": 16, \"flags\": 1},\n            {\"matrix\": [1, 3], \"x\": 56, \"y\": 16, \"flags\": 1},\n            {\"matrix\": [1, 2], \"x\": 112, \"y\": 16, \"flags\": 4},\n            {\"matrix\": [1, 1], \"x\": 168, \"y\": 16, \"flags\": 4},\n            {\"matrix\": [1, 0], \"x\": 224, \"y\": 16, \"flags\": 4},\