    /* Layer 0: Base */
    [0] = LAYOUT(
        KC_A, KC_B,
        KC_TRNS, KC_D
    ),
    /* Layer 1: Fn */
    [1] = LAYOUT(
        KC_TRNS, KC_TRNS,
        KC_C, KC_TRNS
    )
