#include QMK_KEYBOARD_H
#include <string.h>

/* ---- Persistent user settings (EEPROM) -----------------------------
 * Generated by codegen/_settings.py. The struct body is built from a
 * field registry so new settings can be added without editing C. Field
 * order is the on-EEPROM layout: only ever append new fields. */
typedef struct __attribute__((packed)) {
    uint8_t active_mode;  /* index into the enabled device_modes list */
} nexus_user_config_t;

nexus_user_config_t g_nexus_config;

void nexus_settings_save(void) {
    uint32_t raw = 0;
    memcpy(&raw, &g_nexus_config, sizeof(g_nexus_config));
    eeconfig_update_user(raw);
}

void eeconfig_init_user(void) {
    g_nexus_config.active_mode = 0;
    nexus_settings_save();
}

void keyboard_post_init_user(void) {
    uint32_t raw = eeconfig_read_user();
        memcpy(&g_nexus_config, &raw, sizeof(g_nexus_config));
}

/* Mode gate: only emit the mouse HID report when mouse is the active
 * device mode. Other modes zero the report (no movement/buttons). */
report_mouse_t pointing_device_task_user(report_mouse_t mouse_report) {
    if (g_nexus_config.active_mode != 1) {
        report_mouse_t empty = {0};
        return empty;
    }
    return mouse_report;
}
