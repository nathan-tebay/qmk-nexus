#include QMK_KEYBOARD_H

enum nexus_macros {
    MODE_NEXT = SAFE_RANGE,
};

const uint16_t PROGMEM keymaps[][MATRIX_ROWS][MATRIX_COLS] = {
    /* Layer 0: Base */
    [0] = LAYOUT(
        MODE_NEXT, KC_B,
        KC_C, KC_D
    )
};

joystick_config_t joystick_axes[JOYSTICK_AXIS_COUNT] = {
    JOYSTICK_AXIS_VIRTUAL,
    JOYSTICK_AXIS_VIRTUAL
};

/* Joystick: poll inputs each scan, gated by the active device mode. */
void matrix_scan_user(void) {
    if (g_nexus_config.active_mode != 2) {
        joystick_set_axis(0, 0);
        joystick_set_axis(1, 0);
        return;
    }
}

bool process_record_user(uint16_t keycode, keyrecord_t *record) {
    if (!record->event.pressed) return true;
    switch (keycode) {
        case MODE_NEXT:
            /* Cycle the active composite-HID device mode + persist it. */
            g_nexus_config.active_mode = (g_nexus_config.active_mode + 1) % 3;
            nexus_settings_save();
            return false;
    }
    return true;
}
