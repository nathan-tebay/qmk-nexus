#include QMK_KEYBOARD_H

const uint16_t PROGMEM keymaps[][MATRIX_ROWS][MATRIX_COLS] = {
    /* Layer 0: Base */
    [0] = LAYOUT(
        KC_A, KC_B,
        KC_C, KC_D
    )
};

joystick_config_t joystick_axes[JOYSTICK_AXIS_COUNT] = {
    JOYSTICK_AXIS_IN(F4, 0, 512, 1023),
    JOYSTICK_AXIS_IN(F5, 0, 512, 1023),
    JOYSTICK_AXIS_VIRTUAL
};

/* Joystick: poll inputs each scan, gated by the active device mode. */
void matrix_scan_user(void) {
    int8_t hat_dir = -1;  /* -1 = centered */
    if (readPin(B2) == 0) hat_dir = 0;  /* N */
    if (readPin(B3) == 0) hat_dir = 2;  /* E */
    if (readPin(B4) == 0) hat_dir = 4;  /* S */
    if (readPin(B5) == 0) hat_dir = 6;  /* W */
    joystick_set_hat(hat_dir);
}
