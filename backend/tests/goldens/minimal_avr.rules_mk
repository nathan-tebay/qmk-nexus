# Generated by QMK Nexus — do not edit manually

MCU = atmega32u4
ARCH = avr
F_CPU = 16000000

F_USB = $(F_CPU)
OPT_DEFS += -DINTERRUPT_CONTROL_ENDPOINT

# Feature flags
RGB_MATRIX_ENABLE = no
RGBLIGHT_ENABLE = no
BACKLIGHT_ENABLE = no
ENCODER_ENABLE = no
OLED_ENABLE = no
SPLIT_KEYBOARD = no
NKRO_ENABLE = yes
BOOTMAGIC_ENABLE = yes
MOUSEKEY_ENABLE = no
EXTRAKEY_ENABLE = yes
CONSOLE_ENABLE = no
COMMAND_ENABLE = no
TAP_DANCE_ENABLE = no
COMBO_ENABLE = no
KEY_LOCK_ENABLE = no
AUDIO_ENABLE = no

# Bootloader
BOOTLOADER = atmel-dfu

# Default LTO for size
LTO_ENABLE = yes
