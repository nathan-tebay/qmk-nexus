#include QMK_KEYBOARD_H
#include "rgb_matrix.h"
#include "oled_driver.h"
#include "pointing_device.h"
#include <string.h>

led_config_t g_led_config = { {
    { 0, 1 },
    { 2, 3 },
}, {
    { 0, 0 },
    { 224, 0 },
    { 0, 64 },
    { 224, 64 },
}, {
    4,
    4,
    4,
    4,
} };

bool oled_task_user(void) {
    oled_write_P(PSTR("SETTINGS\n"), false);
    oled_write_P(g_nexus_config.menu_index == 0 ? PSTR(">") : PSTR(" "), false);
    oled_write_P(PSTR("DPI    "), false);
    oled_write(get_u16_str(pointing_device_get_cpi(), ' '), false);
    oled_write_P(PSTR("\n"), false);
    oled_write_P(g_nexus_config.menu_index == 1 ? PSTR(">") : PSTR(" "), false);
    oled_write_P(PSTR("Mode   "), false);
    switch (g_nexus_config.active_mode) {
        default: oled_write_P(PSTR("?       "), false); break;
    }
    oled_write_P(PSTR("\n"), false);
    oled_write_P(g_nexus_config.menu_index == 2 ? PSTR(">") : PSTR(" "), false);
    oled_write_P(PSTR("RGB    "), false);
    oled_write(get_u8_str(rgb_matrix_get_val(), ' '), false);
    oled_write_P(PSTR("\n"), false);
    oled_write_P(g_nexus_config.menu_index == 3 ? PSTR(">") : PSTR(" "), false);
    oled_write_P(PSTR("Joy    "), false);
    oled_write_P(g_nexus_config.joystick_enabled ? PSTR("ON ") : PSTR("OFF"), false);
    oled_write_P(PSTR("\n"), false);
    return false;
}

/* ---- Persistent user settings (EEPROM) -----------------------------
 * Generated by codegen/_settings.py. The struct body is built from a
 * field registry so new settings can be added without editing C. Field
 * order is the on-EEPROM layout: only ever append new fields. */
typedef struct __attribute__((packed)) {
    uint8_t menu_index;  /* OLED settings-menu cursor position */
    uint8_t rgb_brightness;  /* 0 = follow QMK value; else stored RGB brightness */
    uint8_t joystick_enabled;  /* menu toggle: 1 = joystick output on */
} nexus_user_config_t;

nexus_user_config_t g_nexus_config;

void nexus_settings_save(void) {
    uint32_t raw = 0;
    memcpy(&raw, &g_nexus_config, sizeof(g_nexus_config));
    eeconfig_update_user(raw);
}

void eeconfig_init_user(void) {
    g_nexus_config.menu_index = 0;
    g_nexus_config.rgb_brightness = 0;
    g_nexus_config.joystick_enabled = 1;
    nexus_settings_save();
}

void keyboard_post_init_user(void) {
    uint32_t raw = eeconfig_read_user();
        memcpy(&g_nexus_config, &raw, sizeof(g_nexus_config));
}

/* OLED settings-menu mutators — shared by every input mode (encoder,
 * MENU_* keycodes, pointing-device tap). Cursor + values live in the
 * persisted g_nexus_config; each change is flushed to EEPROM. */
void nx_menu_cursor_next(void) {
    g_nexus_config.menu_index = (g_nexus_config.menu_index + 1) % 4;
    nexus_settings_save();
}

void nx_menu_value_adjust(int8_t dir) {
    switch (g_nexus_config.menu_index) {
        case 0: {  /* dpi_stage */
            uint16_t cpi = pointing_device_get_cpi();
            cpi = (dir > 0) ? cpi + 100 : (cpi > 100 ? cpi - 100 : 100);
            pointing_device_set_cpi(cpi);
            break;
        }
        case 1: {  /* device_mode */
            g_nexus_config.active_mode = (g_nexus_config.active_mode + (dir > 0 ? 1 : 0 - 1)) % 0;
            break;
        }
        case 2: {  /* rgb_brightness */
            if (dir > 0) { rgb_matrix_increase_val(); } else { rgb_matrix_decrease_val(); }
            g_nexus_config.rgb_brightness = rgb_matrix_get_val();
            break;
        }
        case 3: {  /* joystick_enabled */
            g_nexus_config.joystick_enabled = g_nexus_config.joystick_enabled ? 0 : 1;
            break;
        }
        default: break;
    }
    nexus_settings_save();
}
