# Generated by tebay-qmk — do not edit manually

MCU = atmega32u4
ARCH = avr
F_CPU = 16000000

F_USB = $(F_CPU)
OPT_DEFS += -DINTERRUPT_CONTROL_ENDPOINT

# Feature flags
RGB_MATRIX_ENABLE = yes
RGBLIGHT_ENABLE = no
BACKLIGHT_ENABLE = no
ENCODER_ENABLE = no
OLED_ENABLE = no
SPLIT_KEYBOARD = yes
NKRO_ENABLE = yes
BOOTMAGIC_ENABLE = no
MOUSEKEY_ENABLE = no
EXTRAKEY_ENABLE = no
CONSOLE_ENABLE = no
COMMAND_ENABLE = no
TAP_DANCE_ENABLE = no
COMBO_ENABLE = no
KEY_LOCK_ENABLE = no
AUDIO_ENABLE = no

RGB_MATRIX_DRIVER = ws2812

# Bootloader
BOOTLOADER = atmel-dfu

# Default LTO for size
LTO_ENABLE = yes
